# SWW Matplotlib style — mirrors tokens/charts.css
figure.facecolor: FFFFFF
figure.dpi: 120
savefig.dpi: 200
savefig.facecolor: FFFFFF
savefig.bbox: tight

font.family: sans-serif
font.sans-serif: IBM Plex Sans, Segoe UI, DejaVu Sans
axes.formatter.use_locale: True
font.size: 11
text.color: 141A21

axes.facecolor: FFFFFF
axes.edgecolor: E4E9EF
axes.linewidth: 1.0
axes.labelcolor: 6B7887
axes.labelsize: 11
axes.titlesize: 14
axes.titleweight: 600
axes.titlelocation: left
axes.titlecolor: 141A21
axes.titlepad: 14
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: y
axes.prop_cycle: cycler('color', ['084878','0080A0','58A858','0090C8','C77E11','6CC0D2','4E5A68','B3261E'])

grid.color: E4E9EF
grid.linewidth: 0.8
grid.alpha: 1.0

xtick.color: 6B7887
ytick.color: 6B7887
xtick.labelsize: 10
ytick.labelsize: 10
xtick.direction: out
ytick.direction: out

lines.linewidth: 2.0
lines.markersize: 5
lines.solid_capstyle: round

legend.frameon: False
legend.fontsize: 10
legend.labelcolor: 6B7887
